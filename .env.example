# GEMINI_API_KEY: Required if optional AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: HTTP Server listening port (must be 3000 in preview environment)
PORT=3000

# DB_PATH: Path to the SQLite database file (use ":memory:" for isolated tests)
DB_PATH="./data/contacts.sqlite"

# JSON_BACKUP_PATH: Path to the synchronized JSON backup mirror
JSON_BACKUP_PATH="./data/contacts.backup.json"

# RATE_LIMIT_MAX_REQUESTS: Maximum API requests per minute per client
RATE_LIMIT_MAX_REQUESTS=180

# DEFAULT_ROLE: Default RBAC role when none is specified (admin | editor | viewer)
DEFAULT_ROLE="admin"

